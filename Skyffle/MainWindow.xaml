<Window
    x:Class="Skyffle.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:vm="using:Skyffle.ViewModels"
    xmlns:m="using:Skyffle.Models"
    Title="Skyffle">

    <Grid RequestedTheme="Dark">
        <!-- animated GPU sky -->
        <!-- ClearColor is a mid-sky tone so a late frame shows sky, never a black flash;
             code-behind swaps it to a night tone when the applied weather is nighttime -->
        <canvas:CanvasAnimatedControl
            x:Name="SkyCanvas"
            ClearColor="#FF41618E"
            CreateResources="OnCreateResources"
            Draw="OnDraw" />

        <!-- content -->
        <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto">
            <!-- 64px side gutters keep the edge carousel arrows clear of the
                 left-aligned hero text and cards at the minimum window width -->
            <Grid MaxWidth="840" Padding="64,0,64,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- hero: right-click switches °C/°F. Code-behind shifts the text ink
                     from white to deep navy when the sun's glow drifts behind it, so
                     the type keeps contrast without any scrim or shadow -->
                <StackPanel x:Name="HeroPanel" Grid.Row="1" HorizontalAlignment="Left"
                            Margin="0,140,0,10" Spacing="2"
                            Background="Transparent" RightTapped="OnHeroRightTapped"
                            ToolTipService.ToolTip="Right-click to switch between °C and °F">
                    <TextBlock x:Name="CityText" Text="{x:Bind ViewModel.LocationName, Mode=OneWay}"
                               FontSize="20" FontWeight="Medium" HorizontalAlignment="Left"
                               Foreground="{StaticResource TextSecondary}" />
                    <!-- big bold reading; the unit shares the size and baseline but stays light;
                         negative top margin swallows the 104px line's ascent slack under the city -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-4,-20,0,-8">
                        <TextBlock x:Name="TempText" Text="{x:Bind ViewModel.CurrentTemp, Mode=OneWay}"
                                   FontSize="104" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="UnitText" Text="{x:Bind ViewModel.TempUnit, Mode=OneWay}"
                                   FontSize="104" FontWeight="Light" Margin="-4,0,0,0"
                                   Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                    <TextBlock x:Name="ConditionText" Text="{x:Bind ViewModel.Condition, Mode=OneWay}"
                               FontSize="20" FontWeight="Medium" HorizontalAlignment="Left"
                               Foreground="{StaticResource TextSecondary}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
                        <TextBlock x:Name="HiLoText" Text="{x:Bind ViewModel.HiLo, Mode=OneWay}"
                                   FontSize="15" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="FeelsText" Text="{x:Bind ViewModel.FeelsLikeShort, Mode=OneWay}"
                                   FontSize="15" FontWeight="Medium"
                                   Foreground="{StaticResource TextTertiary}" />
                    </StackPanel>
                    <!-- loading is shown ambiently: code-behind dims the content column
                         while a forecast is in flight, so nothing shifts the layout -->
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               FontSize="13" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Foreground="#FFFFB3AB" />
                </StackPanel>

                <!-- hourly forecast -->
                <Border x:Name="HourlyCard" Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="HOURLY FORECAST" Style="{StaticResource CardHeader}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Hours}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="18" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HourItem">
                                        <StackPanel Spacing="6" MinWidth="44">
                                            <TextBlock Text="{x:Bind TimeLabel}" FontSize="13" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text="{x:Bind Glyph}" FontSize="20" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind PrecipProb}" FontSize="11" HorizontalAlignment="Center"
                                                       Foreground="#FF9CD2FF" Visibility="{x:Bind HasPrecip}" />
                                            <TextBlock Text="{x:Bind Temp}" FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 10-day forecast -->
                <Border x:Name="DailyCard" Grid.Row="3" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="10-DAY FORECAST" Style="{StaticResource CardHeader}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Days}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DayItem">
                                    <Grid Padding="0,9" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind DayLabel}" FontSize="16"
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind PrecipProb}" FontSize="12"
                                                   Foreground="#FF9CD2FF" VerticalAlignment="Center" Visibility="{x:Bind HasPrecip}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind MinLabel}" FontSize="16"
                                                   Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                        <Grid Grid.Column="4" VerticalAlignment="Center" Width="140" HorizontalAlignment="Center">
                                            <Border Height="5" CornerRadius="2.5" Background="#2E000000" />
                                            <Border Height="5" CornerRadius="2.5" HorizontalAlignment="Left"
                                                    Width="{x:Bind BarWidth}" Margin="{x:Bind BarMargin}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF6EC1FF" Offset="0" />
                                                        <GradientStop Color="#FFFFD36E" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="5" Text="{x:Bind MaxLabel}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- detail cards: -4 side margin cancels the item margin so the outer
                     card faces align flush with the forecast cards above; ItemWidth
                     is set from code so the grid always spans the full column -->
                <ItemsControl x:Name="DetailsHost" Grid.Row="4" Margin="-4,0,-4,0"
                              ItemsSource="{x:Bind ViewModel.Details}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="174" ItemHeight="120"
                                                   HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailItem">
                            <Border Style="{StaticResource GlassCard}" Margin="4" Height="112">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardHeader}" Margin="0" />
                                    <TextBlock Text="{x:Bind Value}" FontSize="26" FontWeight="SemiLight"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{x:Bind Caption}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- page-wide location carousel arrows: backplate only appears on hover/press -->
        <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="15"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                Width="40" Height="40" CornerRadius="20" Background="Transparent" BorderThickness="0"
                Foreground="{StaticResource TextPrimary}"
                ToolTipService.ToolTip="Previous city"
                Command="{x:Bind ViewModel.PreviousLocationCommand}">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2EFFFFFF" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#45FFFFFF" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
            </Button.Resources>
        </Button>
        <Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="15"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                Width="40" Height="40" CornerRadius="20" Background="Transparent" BorderThickness="0"
                Foreground="{StaticResource TextPrimary}"
                ToolTipService.ToolTip="Next city"
                Command="{x:Bind ViewModel.NextLocationCommand}">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2EFFFFFF" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#45FFFFFF" />
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
            </Button.Resources>
        </Button>

        <!-- tall custom title bar: drag strip behind, interactive controls on top -->
        <Grid Height="48" VerticalAlignment="Top">
            <Border x:Name="TitleBarDragRegion" Background="Transparent" />
            <TextBlock Text="Skyffle" FontSize="13" Margin="16,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}" IsHitTestVisible="False" />
            <AutoSuggestBox
                x:Name="SearchBox"
                Width="340"
                CornerRadius="20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                PlaceholderText="Search for a city…"
                QueryIcon="Find"
                TextChanged="OnSearchTextChanged"
                SuggestionChosen="OnSuggestionChosen"
                ItemsSource="{x:Bind ViewModel.Suggestions}">
                <AutoSuggestBox.TextBoxStyle>
                    <Style TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                        <Setter Property="CornerRadius" Value="20" />
                        <Setter Property="Padding" Value="16,8,12,10" />
                    </Style>
                </AutoSuggestBox.TextBoxStyle>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="m:GeoResult">
                        <TextBlock Text="{x:Bind Display}" />
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <!-- right margin clears the (tall) caption buttons -->
            <Button Content="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="14"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,160,0"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="More options">
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Refresh" Command="{x:Bind ViewModel.RefreshCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Remove this city" Command="{x:Bind ViewModel.RemoveSelectedCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</Window>

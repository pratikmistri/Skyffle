<Application
    x:Class="Skyffle.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Frosted glass card look used across the app -->
            <SolidColorBrush x:Key="CardFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="CardFillDeep" Color="#40182338" />
            <SolidColorBrush x:Key="CardStroke" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="TextTertiary" Color="#7DFFFFFF" />

            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardFillDeep}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="CardHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
